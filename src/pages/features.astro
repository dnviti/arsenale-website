---

<BaseLayout
  title="Features — Arsenale Privileged Access Manager"
  description="Explore all Arsenale features: SSH terminal, RDP desktop, encrypted vault, team collaboration, multi-factor authentication, audit logging, and more."
  canonicalPath="/features/"
>
  <section class="pt-32 pb-24">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
      <div data-animate>
        <SectionHeading
          title="Features"
          subtitle="Everything you need to manage secure remote access across your infrastructure"
        />
      </div>

      {categories.map((category, catIdx) => (
        <div class="mb-20" data-animate>
          <div class="flex items-center gap-4 mb-8">
            <span class="font-serif text-xl text-accent/30 select-none">
              {String(catIdx + 1).padStart(2, '0')}
            </span>
            <h3 class="text-xl font-serif text-text-primary">
              {category.name}
            </h3>
            <div class="flex-1 h-px bg-dark-border/60"></div>
          </div>
          <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-5">
            {category.features.map((feature) => (
              <FeatureCard
                title={feature.title}
                description={feature.description}
                icon={feature.icon}
              />
            ))}
          </div>
        </div>
      ))}
    </div>
  </section>
</BaseLayout>

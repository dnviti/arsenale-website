---
import BaseLayout from '../layouts/BaseLayout.astro';
import SectionHeading from '../components/shared/SectionHeading.astro';
import FeatureCard from '../components/features/FeatureCard.astro';

const categories = [
  {
    name: 'Core Connectivity',
    features: [
      {
        title: 'SSH Terminal',
        description: 'Interactive terminal sessions via XTerm.js with real-time I/O over WebSocket. Full keyboard support, copy/paste, and terminal resizing.',
        icon: '<svg viewBox="0 0 24 24" width="24" height="24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="4 17 10 11 4 5" /><line x1="12" y1="19" x2="20" y2="19" /></svg>',
      },
      {
        title: 'RDP Remote Desktop',
        description: 'Access Windows desktops through Apache Guacamole with full graphical interface, audio support, clipboard sync, and keyboard layout configuration.',
        icon: '<svg viewBox="0 0 24 24" width="24" height="24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="3" width="20" height="14" rx="2" /><line x1="8" y1="21" x2="16" y2="21" /><line x1="12" y1="17" x2="12" y2="21" /></svg>',
      },
      {
        title: 'VNC Connections',
        description: 'Remote desktop access via VNC protocol through Guacamole. Configurable color depth, cursor mode, clipboard encoding, and view-only settings.',
        icon: '<svg viewBox="0 0 24 24" width="24" height="24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="3" width="20" height="14" rx="2" /><circle cx="12" cy="10" r="3" /><line x1="8" y1="21" x2="16" y2="21" /><line x1="12" y1="17" x2="12" y2="21" /></svg>',
      },
      {
        title: 'Database Connections',
        description: 'Connect to PostgreSQL, MySQL, MSSQL, Oracle, DB2, and MongoDB as a new connection tab type alongside SSH, RDP, and VNC.',
        icon: '<svg viewBox="0 0 24 24" width="24" height="24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><ellipse cx="12" cy="5" rx="9" ry="3" /><path d="M21 12c0 1.66-4 3-9 3s-9-1.34-9-3" /><path d="M3 5v14c0 1.66 4 3 9 3s9-1.34 9-3V5" /></svg>',
      },
      {
        title: 'Multi-Tab Sessions',
        description: 'Open multiple SSH, RDP, and VNC sessions simultaneously in a tabbed interface. Switch between sessions without disconnecting.',
        icon: '<svg viewBox="0 0 24 24" width="24" height="24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="18" height="18" rx="2" /><line x1="3" y1="9" x2="21" y2="9" /><line x1="9" y1="3" x2="9" y2="9" /></svg>',
      },
      {
        title: 'Auto-Reconnection',
        description: 'Automatic reconnection with exponential backoff for transient network interruptions. Visual overlay shows reconnection progress.',
        icon: '<svg viewBox="0 0 24 24" width="24" height="24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="23 4 23 10 17 10" /><polyline points="1 20 1 14 7 14" /><path d="M3.51 9a9 9 0 0 1 14.85-3.36L23 10M1 14l4.64 4.36A9 9 0 0 0 20.49 15" /></svg>',
      },
      {
        title: 'Popup Windows',
        description: 'Open connections in standalone popup windows for multi-monitor setups. Session persists independently of the main workspace.',
        icon: '<svg viewBox="0 0 24 24" width="24" height="24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="3" width="20" height="14" rx="2" /><rect x="8" y="7" width="14" height="14" rx="2" /></svg>',
      },
    ],
  },
  {
    name: 'Database Client',
    features: [
      {
        title: 'Web-Based SQL Client',
        description: 'Connect to PostgreSQL, MySQL, MSSQL, Oracle, DB2, and MongoDB directly from your browser. A new connection tab type for database access with full session management.',
        icon: '<svg viewBox="0 0 24 24" width="24" height="24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><ellipse cx="12" cy="5" rx="9" ry="3" /><path d="M21 12c0 1.66-4 3-9 3s-9-1.34-9-3" /><path d="M3 5v14c0 1.66 4 3 9 3s9-1.34 9-3V5" /></svg>',
      },
      {
        title: 'Monaco SQL Editor',
        description: 'Full-featured SQL editor powered by Monaco with database-aware IntelliSense autocomplete, real-time validation, and custom themes including Dracula and Solarized.',
        icon: '<svg viewBox="0 0 24 24" width="24" height="24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="4 17 10 11 4 5" /><line x1="12" y1="19" x2="20" y2="19" /></svg>',
      },
      {
        title: 'AI-Assisted SQL Generation',
        description: 'Convert natural language to SQL queries with an AI-powered assistant. Table approval workflow ensures queries only access authorized tables.',
        icon: '<svg viewBox="0 0 24 24" width="24" height="24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M12 2L2 7l10 5 10-5-10-5z" /><path d="M2 17l10 5 10-5" /><path d="M2 12l10 5 10-5" /></svg>',
      },
      {
        title: 'SQL Execution Visualizer',
        description: 'Visual query execution plans with interactive diagrams. AI-powered optimization suggestions help identify slow queries and improve performance.',
        icon: '<svg viewBox="0 0 24 24" width="24" height="24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="22 12 18 12 15 21 9 3 6 12 2 12" /></svg>',
      },
      {
        title: 'Query History & Saved Queries',
        description: 'User-scoped query history with local storage persistence. Save and organize frequently used queries for quick access.',
        icon: '<svg viewBox="0 0 24 24" width="24" height="24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10" /><polyline points="12 6 12 12 16 14" /></svg>',
      },
      {
        title: 'Query Rate Limiting',
        description: 'Configurable per-user and per-tenant SQL query rate limits to prevent abuse and protect database resources.',
        icon: '<svg viewBox="0 0 24 24" width="24" height="24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z" /><line x1="12" y1="8" x2="12" y2="12" /><line x1="12" y1="16" x2="12.01" y2="16" /></svg>',
      },
      {
        title: 'Database Session Configuration',
        description: 'Per-connection session parameters including active database, timezone, search path, and encoding. Configure session settings through a dedicated UI.',
        icon: '<svg viewBox="0 0 24 24" width="24" height="24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="3" /><path d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 0 1 0 2.83 2 2 0 0 1-2.83 0l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 0 1-2 2 2 2 0 0 1-2-2v-.09A1.65 1.65 0 0 0 9 19.4a1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 0 1-2.83 0 2 2 0 0 1 0-2.83l.06-.06A1.65 1.65 0 0 0 4.68 15a1.65 1.65 0 0 0-1.51-1H3a2 2 0 0 1-2-2 2 2 0 0 1 2-2h.09A1.65 1.65 0 0 0 4.6 9a1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 0 1 0-2.83 2 2 0 0 1 2.83 0l.06.06A1.65 1.65 0 0 0 9 4.68a1.65 1.65 0 0 0 1-1.51V3a2 2 0 0 1 2-2 2 2 0 0 1 2 2v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 0 1 2.83 0 2 2 0 0 1 0 2.83l-.06.06a1.65 1.65 0 0 0-.33 1.82V9a1.65 1.65 0 0 0 1.51 1H21a2 2 0 0 1 2 2 2 2 0 0 1-2 2h-.09a1.65 1.65 0 0 0-1.51 1z" /></svg>',
      },
    ],
  },
  {
    name: 'Connection Management',
    features: [
      {
        title: 'Folder Organization',
        description: 'Hierarchical folder tree with drag-and-drop reordering. Organize connections by project, environment, or team.',
        icon: '<svg viewBox="0 0 24 24" width="24" height="24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M22 19a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h5l2 3h9a2 2 0 0 1 2 2z" /></svg>',
      },
      {
        title: 'Search & Filter',
        description: 'Instantly find connections by name, host, type, or description. Filter by favorites and recent connections.',
        icon: '<svg viewBox="0 0 24 24" width="24" height="24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="8" /><line x1="21" y1="21" x2="16.65" y2="16.65" /></svg>',
      },
      {
        title: 'Import & Export',
        description: 'Import and export connections via CSV, JSON, mRemoteNG configuration files, and RDP files for easy migration from other tools.',
        icon: '<svg viewBox="0 0 24 24" width="24" height="24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4" /><polyline points="17 8 12 3 7 8" /><line x1="12" y1="3" x2="12" y2="15" /></svg>',
      },
      {
        title: 'SSH Gateways',
        description: 'Bastion host configurations for routing connections through intermediate jump hosts. Supports both manual and managed gateways.',
        icon: '<svg viewBox="0 0 24 24" width="24" height="24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><rect x="1" y="6" width="6" height="12" rx="1" /><rect x="17" y="6" width="6" height="12" rx="1" /><rect x="9" y="9" width="6" height="6" rx="1" /><line x1="7" y1="12" x2="9" y2="12" /><line x1="15" y1="12" x2="17" y2="12" /></svg>',
      },
      {
        title: 'External Sync',
        description: 'Automatically import and synchronize connections from external data sources like NetBox with scheduled sync profiles.',
        icon: '<svg viewBox="0 0 24 24" width="24" height="24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="23 4 23 10 17 10" /><path d="M20.49 15a9 9 0 1 1-2.12-9.36L23 10" /></svg>',
      },
    ],
  },
  {
    name: 'File Transfer',
    features: [
      {
        title: 'SFTP File Browser',
        description: 'Built-in file browser for SSH sessions. Upload, download, create directories, rename, and delete files with a visual interface.',
        icon: '<svg viewBox="0 0 24 24" width="24" height="24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4" /><polyline points="7 10 12 15 17 10" /><line x1="12" y1="15" x2="12" y2="3" /></svg>',
      },
      {
        title: 'RDP Drive Redirection',
        description: 'Mount local drives in your RDP session. Transfer files between your browser and the remote Windows machine via a built-in file browser.',
        icon: '<svg viewBox="0 0 24 24" width="24" height="24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M22 12h-4l-3 9L9 3l-3 9H2" /></svg>',
      },
      {
        title: 'Transfer Queue',
        description: 'Chunked file transfers (64 KB chunks, up to 100 MB) with progress tracking. Queue multiple transfers simultaneously.',
        icon: '<svg viewBox="0 0 24 24" width="24" height="24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><line x1="8" y1="6" x2="21" y2="6" /><line x1="8" y1="12" x2="21" y2="12" /><line x1="8" y1="18" x2="21" y2="18" /><line x1="3" y1="6" x2="3.01" y2="6" /><line x1="3" y1="12" x2="3.01" y2="12" /><line x1="3" y1="18" x2="3.01" y2="18" /></svg>',
      },
    ],
  },
  {
    name: 'Vault & Secrets',
    features: [
      {
        title: 'AES-256-GCM Encryption',
        description: 'Zero-knowledge vault architecture. All credentials encrypted at rest with AES-256-GCM. Master keys derived via Argon2id and never stored on the server.',
        icon: '<svg viewBox="0 0 24 24" width="24" height="24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z" /></svg>',
      },
      {
        title: 'Secrets Manager',
        description: 'Store login credentials, SSH key pairs, TLS certificates, API keys, and encrypted notes. Full version history with restore capability.',
        icon: '<svg viewBox="0 0 24 24" width="24" height="24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M21 2l-2 2m-7.61 7.61a5.5 5.5 0 1 1-7.78 7.78 5.5 5.5 0 0 1 7.78-7.78zm0 0L15.5 7.5m0 0l3 3L22 7l-3-3m-3.5 3.5L19 4" /></svg>',
      },
      {
        title: 'Secret Expiry Notifications',
        description: 'Set expiry dates on secrets with automated scope-aware notifications. Configurable notification bands at 1, 7, and 30 days before expiration.',
        icon: '<svg viewBox="0 0 24 24" width="24" height="24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10" /><polyline points="12 6 12 12 16 14" /></svg>',
      },
      {
        title: 'External Credential Providers',
        description: 'Reference credentials from HashiCorp Vault instead of duplicating them. In-memory caching with configurable TTL. External credentials are never persisted.',
        icon: '<svg viewBox="0 0 24 24" width="24" height="24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="11" width="18" height="11" rx="2" ry="2" /><path d="M7 11V7a5 5 0 0 1 10 0v4" /><circle cx="12" cy="16" r="1" /></svg>',
      },
      {
        title: 'Vault Auto-Lock',
        description: 'Configurable inactivity timeout with MFA re-unlock. Tenant admins can enforce maximum auto-lock durations across the organization.',
        icon: '<svg viewBox="0 0 24 24" width="24" height="24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="11" width="18" height="11" rx="2" ry="2" /><path d="M7 11V7a5 5 0 0 1 10 0v4" /></svg>',
      },
      {
        title: 'Pwned Secret Detection',
        description: 'Vault secrets checked against HaveIBeenPwned using k-Anonymity to detect compromised credentials without exposing them.',
        icon: '<svg viewBox="0 0 24 24" width="24" height="24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M10.29 3.86L1.82 18a2 2 0 0 0 1.71 3h16.94a2 2 0 0 0 1.71-3L13.71 3.86a2 2 0 0 0-3.42 0z" /><line x1="12" y1="9" x2="12" y2="13" /><line x1="12" y1="17" x2="12.01" y2="17" /></svg>',
      },
    ],
  },
  {
    name: 'Authentication & SSO',
    features: [
      {
        title: 'Multi-Factor Authentication',
        description: 'TOTP authenticator apps, SMS verification (Twilio, AWS SNS, Vonage), and WebAuthn/Passkeys (FIDO2) for phishing-resistant login.',
        icon: '<svg viewBox="0 0 24 24" width="24" height="24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="11" width="18" height="11" rx="2" ry="2" /><path d="M7 11V7a5 5 0 0 1 10 0v4" /></svg>',
      },
      {
        title: 'OAuth & OIDC',
        description: 'Sign in with Google, Microsoft, GitHub, or any OIDC-compliant provider (Authentik, Keycloak, Authelia, Zitadel). Link multiple providers to one account.',
        icon: '<svg viewBox="0 0 24 24" width="24" height="24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M15 3h4a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2h-4" /><polyline points="10 17 15 12 10 7" /><line x1="15" y1="12" x2="3" y2="12" /></svg>',
      },
      {
        title: 'SAML 2.0',
        description: 'Enterprise SSO with Azure AD/Entra ID, Okta, OneLogin, and ADFS. Full SAML 2.0 identity provider integration.',
        icon: '<svg viewBox="0 0 24 24" width="24" height="24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M12 2L2 7l10 5 10-5-10-5z" /><path d="M2 17l10 5 10-5" /><path d="M2 12l10 5 10-5" /></svg>',
      },
      {
        title: 'LDAP / Active Directory',
        description: 'Authenticate against existing LDAP/AD servers with STARTTLS, group-based access control, auto-provisioning, and periodic background sync.',
        icon: '<svg viewBox="0 0 24 24" width="24" height="24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="2" width="20" height="8" rx="2" ry="2" /><rect x="2" y="14" width="20" height="8" rx="2" ry="2" /><line x1="6" y1="6" x2="6.01" y2="6" /><line x1="6" y1="18" x2="6.01" y2="18" /></svg>',
      },
      {
        title: 'Password Breach Protection',
        description: 'Passwords checked against HaveIBeenPwned using k-Anonymity. Real-time strength meter powered by zxcvbn on all password forms.',
        icon: '<svg viewBox="0 0 24 24" width="24" height="24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M10.29 3.86L1.82 18a2 2 0 0 0 1.71 3h16.94a2 2 0 0 0 1.71-3L13.71 3.86a2 2 0 0 0-3.42 0z" /><line x1="12" y1="9" x2="12" y2="13" /><line x1="12" y1="17" x2="12.01" y2="17" /></svg>',
      },
    ],
  },
  {
    name: 'Collaboration',
    features: [
      {
        title: 'Connection Sharing',
        description: 'Share connections with granular permissions: read-only or full access. Batch sharing and folder-level sharing supported.',
        icon: '<svg viewBox="0 0 24 24" width="24" height="24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><circle cx="18" cy="5" r="3" /><circle cx="6" cy="12" r="3" /><circle cx="18" cy="19" r="3" /><line x1="8.59" y1="13.51" x2="15.42" y2="17.49" /><line x1="15.41" y1="6.51" x2="8.59" y2="10.49" /></svg>',
      },
      {
        title: 'External Sharing',
        description: 'Create time-limited, access-limited links for secrets shareable outside the platform. Optional PIN protection with configurable expiry and max access counts.',
        icon: '<svg viewBox="0 0 24 24" width="24" height="24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M10 13a5 5 0 0 0 7.54.54l3-3a5 5 0 0 0-7.07-7.07l-1.72 1.71" /><path d="M14 11a5 5 0 0 0-7.54-.54l-3 3a5 5 0 0 0 7.07 7.07l1.71-1.71" /></svg>',
      },
      {
        title: 'Multi-Tenant Teams',
        description: 'Organizations with seven-level role hierarchy (Owner to Guest). Teams with their own connection pools, folders, and vault sections.',
        icon: '<svg viewBox="0 0 24 24" width="24" height="24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2" /><circle cx="9" cy="7" r="4" /><path d="M23 21v-2a4 4 0 0 0-3-3.87" /><path d="M16 3.13a4 4 0 0 1 0 7.75" /></svg>',
      },
      {
        title: 'Team Vaults',
        description: 'Per-team encrypted credential storage. Team master keys are encrypted with each member\'s personal key for zero-trust sharing.',
        icon: '<svg viewBox="0 0 24 24" width="24" height="24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16z" /></svg>',
      },
      {
        title: 'Time-Limited Memberships',
        description: 'Set expiration dates on tenant and team memberships. Expired memberships are automatically cleaned up with refresh token revocation.',
        icon: '<svg viewBox="0 0 24 24" width="24" height="24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10" /><polyline points="12 6 12 12 16 14" /></svg>',
      },
    ],
  },
  {
    name: 'Security & Compliance',
    features: [
      {
        title: 'Data Loss Prevention',
        description: 'Tenant-level DLP policies controlling clipboard and file operations. Per-connection overrides enforce most-restrictive rules. Browser exfiltration vectors blocked.',
        icon: '<svg viewBox="0 0 24 24" width="24" height="24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z" /><line x1="9" y1="9" x2="15" y2="15" /><line x1="15" y1="9" x2="9" y2="15" /></svg>',
      },
      {
        title: 'IP Allowlists',
        description: 'Restrict login by IP address or CIDR range per tenant. Flag or block mode with enforcement across all auth paths including OAuth and SAML.',
        icon: '<svg viewBox="0 0 24 24" width="24" height="24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10" /><line x1="2" y1="12" x2="22" y2="12" /><path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z" /></svg>',
      },
      {
        title: 'Impossible Travel Detection',
        description: 'Haversine-based geo-velocity analysis flags login attempts requiring physically impossible travel speeds between consecutive sessions.',
        icon: '<svg viewBox="0 0 24 24" width="24" height="24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z" /><circle cx="12" cy="10" r="3" /></svg>',
      },
      {
        title: 'Token Binding',
        description: 'JWT tokens bound to originating IP and User-Agent via SHA-256 hash. Mismatched tokens are rejected and the entire token family is revoked.',
        icon: '<svg viewBox="0 0 24 24" width="24" height="24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="11" width="18" height="11" rx="2" ry="2" /><path d="M7 11V7a5 5 0 0 1 10 0v4" /></svg>',
      },
      {
        title: 'Connection Policies',
        description: 'Organization-wide enforced connection settings that override user and per-connection configurations. Enforced fields shown with a lock icon.',
        icon: '<svg viewBox="0 0 24 24" width="24" height="24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z" /><polyline points="9 12 11 14 15 10" /></svg>',
      },
      {

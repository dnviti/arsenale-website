---
import BaseLayout from '../layouts/BaseLayout.astro';
import SectionHeading from '../components/shared/SectionHeading.astro';

const credentials = [
  { label: 'URL', value: 'demo.arsenalepam.com' },
  { label: 'Email', value: 'demo@arsenalepam.com' },
  { label: 'Password', value: 'arsenaledemo' },
];

const thingsToTry = [
  'Log in and unlock your encrypted vault',
  'Browse the connection tree and open an SSH terminal',
  'Open an RDP remote desktop session',
  'Customize your terminal theme and font',
  'Try the SFTP file browser in an SSH session',
  'Explore the audit log to see tracked actions',
  'Check out the settings page and linked accounts',
  'Try the search bar to filter connections',
];
---

<BaseLayout
  title="Try the Demo — Arsenale Privileged Access Manager"
  description="Try Arsenale for free with our online demo. No installation required. Explore SSH terminals, RDP desktops, encrypted vaults, and team collaboration."
  canonicalPath="/demo/"
>
  <section class="pt-32 pb-20">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
      <SectionHeading
        title="Try the Demo"
        subtitle="Explore the full Arsenale interface with pre-configured connections. No installation required."
      />

      <!-- Credentials card -->
      <div class="bg-dark-surface border border-primary/30 rounded-2xl p-8 sm:p-10 max-w-lg mx-auto mb-12">
        <h3 class="text-lg font-semibold text-white mb-6 text-center">Demo Credentials</h3>
        <div class="space-y-4 font-mono">
          {credentials.map(({ label, value }) => (
            <div class="flex items-center justify-between gap-4 bg-dark-bg rounded-lg px-4 py-3">
              <span class="text-text-muted text-sm shrink-0 w-20">{label}</span>
              <span class:list={[
                'text-sm flex-1 text-right',
                label === 'URL' ? 'text-accent' : 'text-text-primary',
              ]}>{value}</span>
              <button
                class="copy-btn shrink-0 p-1.5 text-text-muted hover:text-primary transition-colors rounded"
                data-value={label === 'URL' ? `https://${value}` : value}
                aria-label={`Copy ${label}`}
              >
                <svg class="copy-icon" viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <rect x="9" y="9" width="13" height="13" rx="2" ry="2" />
                  <path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1" />
                </svg>
                <svg class="check-icon hidden" viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <polyline points="20 6 9 17 4 12" />
                </svg>
              </button>
            </div>
          ))}
        </div>

        <div class="mt-8 text-center">
          <a
            href="https://demo.arsenalepam.com"
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center gap-2 px-8 py-3.5 text-base font-semibold text-white bg-primary hover:bg-primary-dark rounded-lg transition-colors shadow-lg shadow-primary/25 w-full justify-center"
          >
            <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6" />
              <polyline points="15 3 21 3 21 9" />
              <line x1="10" y1="14" x2="21" y2="3" />
            </svg>
            Launch Demo
          </a>
        </div>

        <p class="mt-4 text-xs text-text-muted text-center">
          Demo environment resets periodically. Do not store real credentials.
        </p>
      </div>

      <!-- What to try -->
      <div class="bg-dark-surface border border-dark-border rounded-2xl p-8 sm:p-10 max-w-lg mx-auto">
        <h3 class="text-lg font-semibold text-white mb-6">What to Try</h3>
        <ul class="space-y-3">
          {thingsToTry.map((item) => (
            <li class="flex items-start gap-3 text-text-secondary text-sm">
              <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-primary shrink-0 mt-0.5">
                <polyline points="9 11 12 14 22 4" />
                <path d="M21 12v7a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11" />
              </svg>
              {item}
            </li>
          ))}
        </ul>
      </div>
    </div>
  </section>
</BaseLayout>

<script>
  document.querySelectorAll('.copy-btn').forEach((btn) => {
    btn.addEventListener('click', async () => {
      const value = btn.getAttribute('data-value');
      if (!value) return;

      try {
        await navigator.clipboard.writeText(value);
        const copyIcon = btn.querySelector('.copy-icon')!;
        const checkIcon = btn.querySelector('.check-icon')!;
        copyIcon.classList.add('hidden');
        checkIcon.classList.remove('hidden');
        setTimeout(() => {
          copyIcon.classList.remove('hidden');
          checkIcon.classList.add('hidden');
        }, 2000);
      } catch {
        // Fallback: select text
      }
    });
  });
</script>

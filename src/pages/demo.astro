---
import BaseLayout from '../layouts/BaseLayout.astro';
import SectionHeading from '../components/shared/SectionHeading.astro';

const credentials = [
  { label: 'URL', value: 'demo.arsenalepam.com' },
  { label: 'Email', value: 'demo@arsenalepam.com' },
  { label: 'Password', value: 'arsenaledemo' },
];

const thingsToTry = [
  'Log in and unlock your encrypted vault',
  'Browse the connection tree and open an SSH terminal',
  'Open an RDP remote desktop session',
  'Customize your terminal theme and font',
  'Try the SFTP file browser in an SSH session',
  'Explore the audit log to see tracked actions',
  'Check out the settings page and linked accounts',
  'Try the search bar to filter connections',
];
---

<BaseLayout
  title="Try the Demo — Arsenale Privileged Access Manager"
  description="Try Arsenale for free with our online demo. No installation required. Explore SSH terminals, RDP desktops, encrypted vaults, and team collaboration."
  canonicalPath="/demo/"
>
  <section class="pt-32 pb-24">
    <div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8">
      <div data-animate>
        <SectionHeading
          title="Try the Demo"
          subtitle="Explore the full Arsenale interface with pre-configured connections. No installation required."
        />
      </div>

      <!-- Credentials card -->
      <div class="bg-dark-surface/80 border border-accent/15 rounded-2xl p-8 sm:p-10 max-w-lg mx-auto mb-12" data-animate data-delay="1">
        <h3 class="text-lg font-serif text-text-primary mb-6 text-center">Demo Credentials</h3>

        <!-- Terminal-style display -->
        <div class="bg-dark-bg border border-dark-border/60 rounded-xl p-5 font-mono">
          <div class="flex items-center gap-2 mb-4 pb-3 border-b border-dark-border/40">
            <span class="w-2.5 h-2.5 rounded-full bg-accent/40"></span>
            <span class="w-2.5 h-2.5 rounded-full bg-text-muted/30"></span>
            <span class="w-2.5 h-2.5 rounded-full bg-text-muted/30"></span>
          </div>
          <div class="space-y-3">
            {credentials.map(({ label, value }) => (
              <div class="flex items-center justify-between gap-4">
                <div class="flex items-center gap-3 min-w-0">
                  <span class="text-accent text-sm">$</span>
                  <span class="text-text-muted text-sm w-20 shrink-0">{label}</span>
                </div>
                <span class:list={[
                  'text-sm flex-1 text-right truncate',
                  label === 'URL' ? 'text-accent' : 'text-text-primary',
                ]}>{value}</span>
                <button
                  class="copy-btn shrink-0 p-1.5 text-text-muted hover:text-accent transition-colors duration-300 rounded"
                  data-value={label === 'URL' ? `https://${value}` : value}
                  aria-label={`Copy ${label}`}
                >
                  <svg class="copy-icon" viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <rect x="9" y="9" width="13" height="13" rx="2" ry="2" />
                    <path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1" />
                  </svg>
                  <svg class="check-icon hidden" viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <polyline points="20 6 9 17 4 12" />
                  </svg>
                </button>
              </div>
            ))}
          </div>
        </div>

        <div class="mt-8 text-center">
          <a
            href="https://demo.arsenalepam.com"
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center gap-2.5 px-8 py-3.5 text-[15px] font-semibold text-dark-bg bg-accent hover:bg-accent-dim rounded-lg transition-colors duration-300 w-full justify-center"
          >
            <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
              <path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6" />
              <polyline points="15 3 21 3 21 9" />
              <line x1="10" y1="14" x2="21" y2="3" />
            </svg>
            Launch Demo
          </a>
        </div>

        <p class="mt-4 text-xs text-text-muted text-center">
          Demo environment resets periodically. Do not store real credentials.
        </p>
      </div>

      <!-- What to try -->
      <div class="bg-dark-surface/60 border border-dark-border/60 rounded-2xl p-8 sm:p-10 max-w-lg mx-auto" data-animate data-delay="2">
        <h3 class="text-lg font-serif text-text-primary mb-6">What to Try</h3>
        <ul class="space-y-3.5">
          {thingsToTry.map((item) => (
            <li class="flex items-start gap-3 text-text-secondary text-sm">
              <span class="w-1.5 h-1.5 rounded-full bg-accent/50 mt-2 shrink-0"></span>
              {item}
            </li>
          ))}
        </ul>
      </div>
    </div>
  </section>
</BaseLayout>

<script>
  document.querySelectorAll('.copy-btn').forEach((btn) => {
    btn.addEventListener('click', async () => {
      const value = btn.getAttribute('data-value');
      if (!value) return;

      try {
        await navigator.clipboard.writeText(value);
        const copyIcon = btn.querySelector('.copy-icon')!;
        const checkIcon = btn.querySelector('.check-icon')!;
        copyIcon.classList.add('hidden');
        checkIcon.classList.remove('hidden');
        setTimeout(() => {
          copyIcon.classList.remove('hidden');
          checkIcon.classList.add('hidden');
        }, 2000);
      } catch {
        // Fallback: select text
      }
    });
  });
</script>

---
import BaseLayout from '../layouts/BaseLayout.astro';
import SectionHeading from '../components/shared/SectionHeading.astro';

const docs = [
  {
    title: 'Architecture',
    description: 'System overview, server layers, client structure, real-time communication flows, and network topology.',
    href: 'https://github.com/dnviti/arsenale/blob/main/docs/architecture.md',
    icon: '<svg viewBox="0 0 24 24" width="24" height="24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="7" height="7" /><rect x="14" y="3" width="7" height="7" /><rect x="14" y="14" width="7" height="7" /><rect x="3" y="14" width="7" height="7" /></svg>',
  },
  {
    title: 'API Reference',
    description: 'Complete REST API documentation with all route definitions, request/response formats, and authentication requirements.',
    href: 'https://github.com/dnviti/arsenale/blob/main/docs/api.md',
    icon: '<svg viewBox="0 0 24 24" width="24" height="24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="16 18 22 12 16 6" /><polyline points="8 6 2 12 8 18" /></svg>',
  },
  {
    title: 'Database Schema',
    description: 'Entity relationships, Prisma schema models, enums, indexes, and data flow documentation.',
    href: 'https://github.com/dnviti/arsenale/blob/main/docs/database.md',
    icon: '<svg viewBox="0 0 24 24" width="24" height="24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><ellipse cx="12" cy="5" rx="9" ry="3" /><path d="M21 12c0 1.66-4 3-9 3s-9-1.34-9-3" /><path d="M3 5v14c0 1.66 4 3 9 3s9-1.34 9-3V5" /></svg>',
  },
  {
    title: 'Deployment Guide',
    description: 'Production deployment instructions with Docker Compose, environment configuration, and infrastructure requirements.',
    href: 'https://github.com/dnviti/arsenale/blob/main/docs/deployment.md',
    icon: '<svg viewBox="0 0 24 24" width="24" height="24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 12h-4l-3 9L9 3l-3 9H2" /></svg>',
  },
  {
    title: 'Security',
    description: 'Encryption specifications, vault architecture, authentication flows, and key lifecycle documentation.',
    href: 'https://github.com/dnviti/arsenale/blob/main/docs/security.md',
    icon: '<svg viewBox="0 0 24 24" width="24" height="24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z" /></svg>',
  },
  {
    title: 'Environment Variables',
    description: 'Complete reference for all environment variables: database, JWT, email, SMS, OAuth, Docker, and more.',
    href: 'https://github.com/dnviti/arsenale/blob/main/docs/environment.md',
    icon: '<svg viewBox="0 0 24 24" width="24" height="24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="3" /><path d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 0 1 0 2.83 2 2 0 0 1-2.83 0l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 0 1-2 2 2 2 0 0 1-2-2v-.09A1.65 1.65 0 0 0 9 19.4a1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 0 1-2.83 0 2 2 0 0 1 0-2.83l.06-.06A1.65 1.65 0 0 0 4.68 15a1.65 1.65 0 0 0-1.51-1H3a2 2 0 0 1-2-2 2 2 0 0 1 2-2h.09A1.65 1.65 0 0 0 4.6 9a1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 0 1 0-2.83 2 2 0 0 1 2.83 0l.06.06A1.65 1.65 0 0 0 9 4.68a1.65 1.65 0 0 0 1-1.51V3a2 2 0 0 1 2-2 2 2 0 0 1 2 2v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 0 1 2.83 0 2 2 0 0 1 0 2.83l-.06.06a1.65 1.65 0 0 0-.33 1.82V9a1.65 1.65 0 0 0 1.51 1H21a2 2 0 0 1 2 2 2 2 0 0 1-2 2h-.09a1.65 1.65 0 0 0-1.51 1z" /></svg>',
  },
  {
    title: 'Components',
    description: 'Frontend component tree documentation with hierarchy, props, and interaction patterns.',
    href: 'https://github.com/dnviti/arsenale/blob/main/docs/components.md',
    icon: '<svg viewBox="0 0 24 24" width="24" height="24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="18" height="18" rx="2" /><line x1="3" y1="9" x2="21" y2="9" /><line x1="9" y1="21" x2="9" y2="9" /></svg>',
  },
  {
    title: 'Contributing',
    description: 'Setup guide, code conventions, quality gate, commit guidelines, and pull request process.',
    href: 'https://github.com/dnviti/arsenale/blob/main/CONTRIBUTING.md',
    icon: '<svg viewBox="0 0 24 24" width="24" height="24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2" /><circle cx="9" cy="7" r="4" /><path d="M23 21v-2a4 4 0 0 0-3-3.87" /><path d="M16 3.13a4 4 0 0 1 0 7.75" /></svg>',
  },
];
---

<BaseLayout
  title="Documentation — Arsenale Privileged Access Manager"
  description="Arsenale documentation: architecture, API reference, database schema, deployment guide, security specs, and contributing guidelines."
  canonicalPath="/docs/"
>
  <section class="pt-32 pb-20">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
      <SectionHeading
        title="Documentation"
        subtitle="Technical documentation hosted on GitHub"
      />

      <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
        {docs.map(({ title, description, href, icon }) => (
          <a
            href={href}
            target="_blank"
            rel="noopener noreferrer"
            class="bg-dark-surface border border-dark-border rounded-xl p-6 hover:border-primary/40 transition-all group block"
          >
            <div class="flex items-start gap-4">
              <div class="w-10 h-10 rounded-lg bg-primary/10 flex items-center justify-center text-primary shrink-0 group-hover:bg-primary/20 transition-colors">
                <Fragment set:html={icon} />
              </div>
              <div>
                <h3 class="text-base font-semibold text-white mb-1 group-hover:text-primary transition-colors flex items-center gap-2">
                  {title}
                  <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="opacity-0 group-hover:opacity-100 transition-opacity">
                    <path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6" />
                    <polyline points="15 3 21 3 21 9" />
                    <line x1="10" y1="14" x2="21" y2="3" />
                  </svg>
                </h3>
                <p class="text-sm text-text-secondary leading-relaxed">{description}</p>
              </div>
            </div>
          </a>
        ))}
      </div>

      <div class="mt-12 text-center">
        <p class="text-text-muted text-sm mb-4">All documentation is maintained in the main repository</p>
        <a
          href="https://github.com/dnviti/arsenale"
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center gap-2 text-sm text-primary hover:text-primary-light transition-colors"
        >
          <svg viewBox="0 0 24 24" width="18" height="18" fill="currentColor"><path d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.531 1.032 1.531 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0112 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0022 12.017C22 6.484 17.522 2 12 2z" /></svg>
          View on GitHub
        </a>
      </div>
    </div>
  </section>
</BaseLayout>

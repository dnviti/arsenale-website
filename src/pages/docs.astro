---
import BaseLayout from '../layouts/BaseLayout.astro';
import SectionHeading from '../components/shared/SectionHeading.astro';

const GITHUB_DOCS = 'https://github.com/dnviti/arsenale/blob/main/docs';
const GITHUB_GUIDES = 'https://github.com/dnviti/arsenale/blob/develop/docs/guides';

const guides = [
  {
    title: 'Zero-Trust Tunnel User Guide',
    description: 'Set up and manage outbound-only WebSocket tunnels to reach remote networks without opening inbound ports or using a VPN.',
    href: `${GITHUB_GUIDES}/zero-trust-tunnel-user-guide.md`,
    icon: '<svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z" /><path d="M12 8v4" /><path d="M12 16h.01" /></svg>',
  },
  {
    title: 'Tunnel Implementation Guide',
    description: 'Technical deep-dive into the tunnel architecture: agent lifecycle, WebSocket protocol, health monitoring, and gateway container integration.',
    href: `${GITHUB_GUIDES}/tunnel-implementation-guide.md`,
    icon: '<svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10" /><line x1="2" y1="12" x2="22" y2="12" /><path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z" /></svg>',
  },
];

const docs = [
  {
    title: 'Architecture',
    description: 'System overview, server layers, client structure, real-time communication flows, and network topology.',
    href: `${GITHUB_DOCS}/architecture.md`,
    icon: '<svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="7" height="7" /><rect x="14" y="3" width="7" height="7" /><rect x="14" y="14" width="7" height="7" /><rect x="3" y="14" width="7" height="7" /></svg>',
  },
  {
    title: 'API Reference',
    description: 'REST API documentation across 9 topic files: auth & SSO, vault, connections, sessions, user & 2FA, admin, resources, and WebSocket protocols.',
    href: `${GITHUB_DOCS}/api/overview.md`,
    icon: '<svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="16 18 22 12 16 6" /><polyline points="8 6 2 12 8 18" /></svg>',
    subpages: [
      { title: 'Auth & SSO', href: `${GITHUB_DOCS}/api/auth.md` },
      { title: 'Vault', href: `${GITHUB_DOCS}/api/vault.md` },
      { title: 'Connections', href: `${GITHUB_DOCS}/api/connections.md` },
      { title: 'Sessions', href: `${GITHUB_DOCS}/api/sessions.md` },
      { title: 'User & 2FA', href: `${GITHUB_DOCS}/api/user.md` },
      { title: 'Admin', href: `${GITHUB_DOCS}/api/admin.md` },
      { title: 'Resources', href: `${GITHUB_DOCS}/api/resources.md` },
      { title: 'WebSocket', href: `${GITHUB_DOCS}/api/websocket.md` },
    ],
  },
  {
    title: 'Database Schema',
    description: 'Entity relationships and Prisma models across 7 topic files: core, gateway, vault, session, and supporting models plus enums.',
    href: `${GITHUB_DOCS}/database/overview.md`,
    icon: '<svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><ellipse cx="12" cy="5" rx="9" ry="3" /><path d="M21 12c0 1.66-4 3-9 3s-9-1.34-9-3" /><path d="M3 5v14c0 1.66 4 3 9 3s9-1.34 9-3V5" /></svg>',
    subpages: [
      { title: 'Core Models', href: `${GITHUB_DOCS}/database/core-models.md` },
      { title: 'Gateway Models', href: `${GITHUB_DOCS}/database/gateway-models.md` },
      { title: 'Vault Models', href: `${GITHUB_DOCS}/database/vault-models.md` },
      { title: 'Session Models', href: `${GITHUB_DOCS}/database/session-models.md` },
      { title: 'Supporting Models', href: `${GITHUB_DOCS}/database/supporting-models.md` },
      { title: 'Enums', href: `${GITHUB_DOCS}/database/enums.md` },
    ],
  },
  {
    title: 'Security',
    description: 'Encryption specs, authentication flows, DLP policies, IP allowlists, and production hardening across 4 topic files.',
    href: `${GITHUB_DOCS}/security/encryption.md`,
    icon: '<svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z" /></svg>',
    subpages: [
      { title: 'Encryption', href: `${GITHUB_DOCS}/security/encryption.md` },
      { title: 'Authentication', href: `${GITHUB_DOCS}/security/authentication.md` },
      { title: 'Policies', href: `${GITHUB_DOCS}/security/policies.md` },
      { title: 'Production Hardening', href: `${GITHUB_DOCS}/security/production.md` },
    ],
  },
  {
    title: 'Client Components',
    description: 'Frontend component tree, 14 Zustand stores, 13 custom hooks, and 29 API modules across 5 topic files.',
    href: `${GITHUB_DOCS}/components/overview.md`,
    icon: '<svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="18" height="18" rx="2" /><line x1="3" y1="9" x2="21" y2="9" /><line x1="9" y1="21" x2="9" y2="9" /></svg>',
    subpages: [
      { title: 'UI Components', href: `${GITHUB_DOCS}/components/ui-components.md` },
      { title: 'State Management', href: `${GITHUB_DOCS}/components/stores.md` },
      { title: 'Hooks', href: `${GITHUB_DOCS}/components/hooks.md` },
      { title: 'API Layer', href: `${GITHUB_DOCS}/components/api-layer.md` },
    ],
  },
  {
    title: 'Deployment Guide',
    description: 'Production deployment with Docker Compose, environment configuration, Nginx setup, and troubleshooting.',
    href: `${GITHUB_DOCS}/deployment.md`,
    icon: '<svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M22 12h-4l-3 9L9 3l-3 9H2" /></svg>',
  },
  {
    title: 'Environment Variables',
    description: 'Complete reference for all environment variables: database, JWT, email, SMS, OAuth, LDAP, Docker, and more.',
    href: `${GITHUB_DOCS}/environment.md`,
    icon: '<svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="3" /><path d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 0 1 0 2.83 2 2 0 0 1-2.83 0l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 0 1-2 2 2 2 0 0 1-2-2v-.09A1.65 1.65 0 0 0 9 19.4a1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 0 1-2.83 0 2 2 0 0 1 0-2.83l.06-.06A1.65 1.65 0 0 0 4.68 15a1.65 1.65 0 0 0-1.51-1H3a2 2 0 0 1-2-2 2 2 0 0 1 2-2h.09A1.65 1.65 0 0 0 4.6 9a1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 0 1 0-2.83 2 2 0 0 1 2.83 0l.06.06A1.65 1.65 0 0 0 9 4.68a1.65 1.65 0 0 0 1-1.51V3a2 2 0 0 1 2-2 2 2 0 0 1 2 2v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 0 1 2.83 0 2 2 0 0 1 0 2.83l-.06.06a1.65 1.65 0 0 0-.33 1.82V9a1.65 1.65 0 0 0 1.51 1H21a2 2 0 0 1 2 2 2 2 0 0 1-2 2h-.09a1.65 1.65 0 0 0-1.51 1z" /></svg>',
  },
  {
    title: 'Contributing',
    description: 'Setup guide, code conventions, quality gate, commit guidelines, and pull request process.',
    href: 'https://github.com/dnviti/arsenale/blob/main/CONTRIBUTING.md',
    icon: '<svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2" /><circle cx="9" cy="7" r="4" /><path d="M23 21v-2a4 4 0 0 0-3-3.87" /><path d="M16 3.13a4 4 0 0 1 0 7.75" /></svg>',
  },
];
---

<BaseLayout
  title="Documentation — Arsenale Privileged Access Manager"
  description="Arsenale documentation: architecture, API reference, database schema, deployment guide, security specs, and contributing guidelines."
  canonicalPath="/docs/"
>
  <section class="pt-32 pb-24">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
      <div data-animate>
        <SectionHeading
          title="Documentation"
          subtitle="Technical documentation hosted on GitHub"
        />
      </div>

      <!-- Guides -->
      <div class="mb-16" data-animate data-delay="1">
        <div class="flex items-center gap-4 mb-6">
          <span class="font-serif text-lg text-accent/30 select-none">01</span>
          <h2 class="text-xl font-serif text-text-primary">Guides</h2>
          <div class="flex-1 h-px bg-dark-border/60"></div>
        </div>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-5">
          {guides.map((guide) => (
            <a
              href={guide.href}
              target="_blank"
              rel="noopener noreferrer"
              class="group block bg-dark-surface/60 border border-dark-border/60 rounded-xl p-6 hover:border-accent/25 transition-all duration-500"
            >
              <div class="flex items-start gap-4">
                <div class="w-10 h-10 rounded-lg bg-accent/8 flex items-center justify-center text-accent shrink-0 group-hover:bg-accent/12 transition-colors duration-500">
                  <Fragment set:html={guide.icon} />
                </div>
                <div>
                  <h3 class="text-base font-semibold text-text-primary mb-1 group-hover:text-accent transition-colors duration-300 flex items-center gap-2">
                    {guide.title}
                    <svg viewBox="0 0 24 24" width="13" height="13" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="opacity-0 group-hover:opacity-100 transition-opacity duration-300">
                      <path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6" />
                      <polyline points="15 3 21 3 21 9" />
                      <line x1="10" y1="14" x2="21" y2="3" />
                    </svg>
                  </h3>
                  <p class="text-sm text-text-secondary leading-relaxed">{guide.description}</p>
                </div>
              </div>
            </a>
          ))}
        </div>
      </div>

      <!-- Reference -->
      <div data-animate data-delay="2">
        <div class="flex items-center gap-4 mb-6">
          <span class="font-serif text-lg text-accent/30 select-none">02</span>
          <h2 class="text-xl font-serif text-text-primary">Reference</h2>
          <div class="flex-1 h-px bg-dark-border/60"></div>
        </div>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-5">
          {docs.map((doc) => (
            <div class="group bg-dark-surface/60 border border-dark-border/60 rounded-xl p-6 hover:border-accent/25 transition-all duration-500">
              <a
                href={doc.href}
                target="_blank"
                rel="noopener noreferrer"
                class="block"
              >
                <div class="flex items-start gap-4">
                  <div class="w-10 h-10 rounded-lg bg-accent/8 flex items-center justify-center text-accent shrink-0 group-hover:bg-accent/12 transition-colors duration-500">
                    <Fragment set:html={doc.icon} />
                  </div>
                  <div>
                    <h3 class="text-base font-semibold text-text-primary mb-1 group-hover:text-accent transition-colors duration-300 flex items-center gap-2">
                      {doc.title}
                      <svg viewBox="0 0 24 24" width="13" height="13" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="opacity-0 group-hover:opacity-100 transition-opacity duration-300">
                        <path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6" />
                        <polyline points="15 3 21 3 21 9" />
                        <line x1="10" y1="14" x2="21" y2="3" />
                      </svg>
                    </h3>
                    <p class="text-sm text-text-secondary leading-relaxed">{doc.description}</p>
                  </div>
                </div>
              </a>
              {doc.subpages && (
                <div class="mt-3 ml-14 flex flex-wrap gap-2">
                  {doc.subpages.map((sub) => (
                    <a
                      href={sub.href}
                      target="_blank"
                      rel="noopener noreferrer"
                      class="text-[11px] text-text-muted hover:text-accent border border-dark-border/50 hover:border-accent/25 rounded-md px-2 py-1 transition-all duration-300"
                    >
                      {sub.title}
                    </a>
                  ))}
                </div>
              )}
            </div>
          ))}
        </div>
      </div>

      <!-- Footer link -->
      <div class="mt-14 text-center" data-animate data-delay="3">
        <p class="text-text-muted text-sm mb-4">All documentation is maintained in the main repository</p>
        <a
          href="https://github.com/dnviti/arsenale"
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center gap-2 text-sm text-accent hover:text-accent-dim transition-colors duration-300"
        >
          <svg viewBox="0 0 24 24" width="16" height="16" fill="currentColor"><path d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.531 1.032 1.531 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0112 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0022 12.017C22 6.484 17.522 2 12 2z" /></svg>
          View on GitHub
        </a>
      </div>
    </div>
  </section>
</BaseLayout>

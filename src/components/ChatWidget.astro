<!-- Chat Toggle Button -->
<button
  id="chat-toggle"
  class="fixed bottom-6 right-6 z-50 w-14 h-14 rounded-full bg-accent text-dark-bg shadow-lg shadow-accent/20 hover:bg-accent-dim transition-all duration-300 flex items-center justify-center hover:scale-105"
  aria-label="Open chat assistant"
>
  <svg id="chat-icon-open" viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
    <path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z" />
  </svg>
  <svg id="chat-icon-close" class="hidden" viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
    <line x1="18" y1="6" x2="6" y2="18" />
    <line x1="6" y1="6" x2="18" y2="18" />
  </svg>
</button>

<!-- Chat Panel -->
<div
  id="chat-panel"
  class="hidden fixed bottom-24 right-6 z-50 bg-dark-surface border border-dark-border/60 rounded-xl shadow-2xl shadow-black/40 flex flex-col overflow-hidden"
  style="width: 384px; height: 512px;"
>
  <!-- Resize handles -->
  <div id="resize-top" class="absolute top-0 left-3 right-0 h-1.5 cursor-n-resize z-10"></div>
  <div id="resize-left" class="absolute top-3 left-0 bottom-0 w-1.5 cursor-w-resize z-10"></div>
  <div id="resize-corner" class="absolute top-0 left-0 w-3 h-3 cursor-nw-resize z-20"></div>

  <!-- Header -->
  <div class="flex items-center justify-between px-4 py-3 bg-dark-raised border-b border-dark-border/60 shrink-0">
    <div class="flex items-center gap-2">
      <div class="w-2 h-2 rounded-full bg-accent/60"></div>
      <h3 class="text-sm font-medium text-text-primary">Arsenale Docs Assistant</h3>
    </div>
    <button id="chat-close" class="p-1 text-text-muted hover:text-text-primary transition-colors duration-300" aria-label="Close chat">
      <svg viewBox="0 0 24 24" width="15" height="15" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <line x1="18" y1="6" x2="6" y2="18" />
        <line x1="6" y1="6" x2="18" y2="18" />
      </svg>
    </button>
  </div>

  <!-- Messages -->
  <div id="chat-messages" class="flex-1 overflow-y-auto px-4 py-4 space-y-4">
    <div class="flex justify-start">
      <div class="max-w-[85%] rounded-lg px-3 py-2 text-sm bg-dark-raised text-text-primary whitespace-pre-wrap">
        Hi! I'm the Arsenale documentation assistant. Ask me anything about Arsenale's architecture, API, deployment, security, and more.
      </div>
    </div>
  </div>

  <!-- Input -->
  <div class="shrink-0 px-4 py-3 border-t border-dark-border/60 bg-dark-surface">
    <form id="chat-form" class="flex gap-2">
      <input
        id="chat-input"
        type="text"
        placeholder="Ask about Arsenale..."
        autocomplete="off"
        class="flex-1 px-3 py-2 text-sm bg-dark-bg border border-dark-border/60 rounded-lg text-text-primary placeholder-text-muted focus:outline-none focus:border-accent/40 transition-colors duration-300"
      />
      <button
        type="submit"
        id="chat-send"
        class="px-3 py-2 bg-accent text-dark-bg text-sm font-medium rounded-lg hover:bg-accent-dim transition-colors duration-300 disabled:opacity-50 disabled:cursor-not-allowed"
      >
        <svg viewBox="0 0 24 24" width="15" height="15" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <line x1="22" y1="2" x2="11" y2="13" />
          <polygon points="22 2 15 22 11 13 2 9 22 2" />
        </svg>
      </button>
    </form>
    <p class="text-[10px] text-text-muted mt-1.5 text-center">Powered by Ollama &middot; Only answers Arsenale docs questions</p>
  </div>
</div>

<script>
  // --- DOM references ---
  const toggle = document.getElementById('chat-toggle')!;
  const panel = document.getElementById('chat-panel')!;
  const closeBtn = document.getElementById('chat-close')!;
  const form = document.getElementById('chat-form') as HTMLFormElement;
  const input = document.getElementById('chat-input') as HTMLInputElement;
  const sendBtn = document.getElementById('chat-send') as HTMLButtonElement;
  const messagesEl = document.getElementById('chat-messages')!;
  const iconOpen = document.getElementById('chat-icon-open')!;
  const iconClose = document.getElementById('chat-icon-close')!;

  // --- Resize logic ---
  const MIN_WIDTH = 300;
  const MIN_HEIGHT = 300;
  const DEFAULT_WIDTH = 384;
  const DEFAULT_HEIGHT = 512;

  function restoreSize() {
    const w = sessionStorage.getItem('chat-width');
    const h = sessionStorage.getItem('chat-height');
    panel.style.width = (w ? parseInt(w, 10) : DEFAULT_WIDTH) + 'px';
    panel.style.height = (h ? parseInt(h, 10) : DEFAULT_HEIGHT) + 'px';
  }

  function saveSize() {
    sessionStorage.setItem('chat-width', String(parseInt(panel.style.width)));
    sessionStorage.setItem('chat-height', String(parseInt(panel.style.height)));
  }

  restoreSize();

  type ResizeDirection = 'top' | 'left' | 'corner';

  function initResize(handleId: string, direction: ResizeDirection) {
    const handle = document.getElementById(handleId)!;

    function onPointerDown(e: PointerEvent) {
      e.preventDefault();
      const startX = e.clientX;
      const startY = e.clientY;
      const startW = panel.offsetWidth;
      const startH = panel.offsetHeight;

      function onPointerMove(e: PointerEvent) {
        const dx = startX - e.clientX;
        const dy = startY - e.clientY;
        const maxW = window.innerWidth - 48;
        const maxH = window.innerHeight - 120;

        if (direction === 'left' || direction === 'corner') {
          const newW = Math.min(maxW, Math.max(MIN_WIDTH, startW + dx));
          panel.style.width = newW + 'px';
        }
        if (direction === 'top' || direction === 'corner') {
          const newH = Math.min(maxH, Math.max(MIN_HEIGHT, startH + dy));
          panel.style.height = newH + 'px';
        }
      }

      function onPointerUp() {
        document.removeEventListener('pointermove', onPointerMove);
        document.removeEventListener('pointerup', onPointerUp);
        saveSize();
      }

      document.addEventListener('pointermove', onPointerMove);
      document.addEventListener('pointerup', onPointerUp);
    }

    handle.addEventListener('pointerdown', onPointerDown);
  }

  initResize('resize-top', 'top');
  initResize('resize-left', 'left');
  initResize('resize-corner', 'corner');

  // --- Chat logic ---
  interface Message {
    role: 'user' | 'assistant';
    content: string;
  }

  const MAX_MESSAGES = 20;
  let messages: Message[] = [];
  let isStreaming = false;

  function toggleChat() {
    const isOpen = !panel.classList.contains('hidden');
    panel.classList.toggle('hidden');
    iconOpen.classList.toggle('hidden');
    iconClose.classList.toggle('hidden');
    toggle.setAttribute('aria-label', isOpen ? 'Open chat assistant' : 'Close chat assistant');
    if (!isOpen) {
      input.focus();
    }
  }

  toggle.addEventListener('click', toggleChat);
  closeBtn.addEventListener('click', toggleChat);

  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && !panel.classList.contains('hidden')) {
      toggleChat();
    }
  });

  function scrollToBottom() {
    messagesEl.scrollTop = messagesEl.scrollHeight;
  }

  function appendMessage(role: 'user' | 'assistant', content: string): HTMLElement {
    const wrapper = document.createElement('div');
    wrapper.className = `flex ${role === 'user' ? 'justify-end' : 'justify-start'}`;

    const bubble = document.createElement('div');
    bubble.className = `max-w-[85%] rounded-lg px-3 py-2 text-sm whitespace-pre-wrap ${
      role === 'user'
        ? 'bg-accent/15 text-text-primary'
        : 'bg-dark-raised text-text-primary'
    }`;

    bubble.textContent = content;

    wrapper.appendChild(bubble);
    messagesEl.appendChild(wrapper);
    scrollToBottom();
    return bubble;
  }

  function showLoading(): HTMLElement {
    const wrapper = document.createElement('div');
    wrapper.className = 'flex justify-start';
    wrapper.id = 'chat-loading';

    const bubble = document.createElement('div');
    bubble.className = 'max-w-[85%] rounded-lg px-3 py-2 text-sm bg-dark-raised text-text-primary';
    bubble.innerHTML = '<span class="inline-flex gap-1"><span class="animate-bounce" style="animation-delay:0ms">.</span><span class="animate-bounce" style="animation-delay:150ms">.</span><span class="animate-bounce" style="animation-delay:300ms">.</span></span>';

    wrapper.appendChild(bubble);
    messagesEl.appendChild(wrapper);
    scrollToBottom();
    return bubble;
  }

  function removeLoading() {
    document.getElementById('chat-loading')?.remove();
  }

  function setDisabled(disabled: boolean) {
    isStreaming = disabled;
    input.disabled = disabled;
    sendBtn.disabled = disabled;
  }

  async function sendMessage(content: string) {
    if (!content.trim() || isStreaming) return;

    if (messages.length >= MAX_MESSAGES) {
      appendMessage('assistant', 'Conversation limit reached. Please refresh the page to start a new conversation.');
      return;
    }

    messages.push({ role: 'user', content });
    appendMessage('user', content);
    input.value = '';
    setDisabled(true);

    showLoading();

    try {
      const res = await fetch('/api/chat', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ messages }),
      });

      removeLoading();

      if (res.status === 429) {
        appendMessage('assistant', 'You\'ve sent too many messages. Please wait a few minutes before trying again.');
        messages.pop();
        setDisabled(false);
        return;
      }

      if (!res.ok) {
        const err = await res.json().catch(() => ({ error: 'Unknown error' }));
        appendMessage('assistant', err.error || 'Something went wrong. Please try again.');
        messages.pop();
        setDisabled(false);
        return;
      }

      // Read SSE stream
      const reader = res.body!.getReader();
      const decoder = new TextDecoder();
      let assistantContent = '';
      const bubble = appendMessage('assistant', '');

      while (true) {
        const { done, value } = await reader.read();
        if (done) break;

        const chunk = decoder.decode(value, { stream: true });
        const lines = chunk.split('\n');

        for (const line of lines) {
          if (line.startsWith('data: ')) {
            const data = line.slice(6);
            if (data === '[DONE]') break;

            try {
              const parsed = JSON.parse(data);
              if (parsed.text) {
                assistantContent += parsed.text;
                bubble.textContent = assistantContent;
                scrollToBottom();
              }
              if (parsed.error) {
                assistantContent += parsed.error;
                bubble.textContent = assistantContent;
              }
            } catch {
              // Skip malformed JSON chunks
            }
          }
        }
      }

      messages.push({ role: 'assistant', content: assistantContent });
    } catch (err) {
      removeLoading();
      appendMessage('assistant', 'Connection error. Please check your network and try again.');
      messages.pop();
    }

    setDisabled(false);
    input.focus();
  }

  form.addEventListener('submit', (e) => {
    e.preventDefault();
    sendMessage(input.value);
  });
</script>

<style>
  /* Mobile full-screen chat panel */
  @media (max-width: 480px) {
    #chat-panel {
      width: 100vw !important;
      height: 100vh !important;
      max-height: 100vh;
      bottom: 0;
      right: 0;
      border-radius: 0;
      border: none;
    }
    #resize-top,
    #resize-left,
    #resize-corner {
      display: none;
    }
  }

  /* Resize handle hover indicators */
  #resize-top:hover,
  #resize-left:hover,
  #resize-corner:hover {
    background: rgba(0, 229, 160, 0.08);
  }
</style>

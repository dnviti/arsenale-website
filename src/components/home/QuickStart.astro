---
import SectionHeading from '../shared/SectionHeading.astro';

const steps = [
  {
    number: '1',
    title: 'Clone',
    code: 'git clone https://github.com/dnviti/arsenale.git\ncd arsenale',
  },
  {
    number: '2',
    title: 'Configure',
    code: 'cp .env.example .env\n# Edit .env with your settings',
  },
  {
    number: '3',
    title: 'Deploy',
    code: 'docker compose up -d',
  },
];
---

<section class="py-20 bg-dark-surface/50">
  <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
    <SectionHeading
      title="Up and Running in Minutes"
      subtitle="Three steps to deploy your own Privileged Access Manager"
    />

    <div class="flex flex-col gap-6">
      {steps.map(({ number, title, code }) => (
        <div class="bg-dark-bg border border-dark-border rounded-xl p-6">
          <div class="flex items-center gap-3 mb-4">
            <span class="w-8 h-8 rounded-full bg-primary/20 text-primary text-sm font-bold flex items-center justify-center">
              {number}
            </span>
            <h3 class="text-lg font-semibold text-white">{title}</h3>
          </div>
          <div class="relative group">
            <pre class="bg-dark-surface rounded-lg p-4 pr-12 text-sm text-text-secondary"><code>{code}</code></pre>
            <button
              class="copy-btn absolute top-3 right-3 p-1.5 rounded-md bg-dark-border/50 text-text-secondary hover:text-white hover:bg-dark-border transition-colors opacity-0 group-hover:opacity-100"
              data-code={code}
              aria-label="Copy to clipboard"
            >
              <svg class="copy-icon" viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="9" y="9" width="13" height="13" rx="2" ry="2"/><path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"/></svg>
              <svg class="check-icon hidden" viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg>
            </button>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>

<script>
  document.querySelectorAll('.copy-btn').forEach((btn) => {
    btn.addEventListener('click', async () => {
      const code = btn.getAttribute('data-code') ?? '';
      await navigator.clipboard.writeText(code);
      const copyIcon = btn.querySelector('.copy-icon') as HTMLElement;
      const checkIcon = btn.querySelector('.check-icon') as HTMLElement;
      copyIcon.classList.add('hidden');
      checkIcon.classList.remove('hidden');
      setTimeout(() => {
        copyIcon.classList.remove('hidden');
        checkIcon.classList.add('hidden');
      }, 2000);
    });
  });
</script>

---
const techs = [
  { name: 'React', color: '#61DAFB' },
  { name: 'Express.js', color: '#f4f4f5' },
  { name: 'PostgreSQL', color: '#4169E1' },
  { name: 'Docker', color: '#2496ED' },
  { name: 'Socket.IO', color: '#f4f4f5' },
  { name: 'Guacamole', color: '#4CAF50' },
  { name: 'Monaco', color: '#007ACC' },
  { name: 'TypeScript', color: '#3178C6' },
  { name: 'Prisma', color: '#5A67D8' },
];
---

<section class="py-14 border-y border-dark-border/40">
  <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
    <p class="text-center text-[11px] text-text-muted uppercase tracking-[0.2em] mb-8">Built With</p>
    <div class="flex flex-wrap items-center justify-center gap-4 sm:gap-6">
      {techs.map(({ name, color }) => (
        <span
          class="text-[13px] font-medium px-4 py-2 rounded-lg bg-dark-surface/60 border border-dark-border/50 text-text-secondary hover:text-text-primary hover:border-dark-border transition-all duration-300"
          style={`border-left: 2px solid ${color}`}
        >
          {name}
        </span>
      ))}
    </div>
  </div>
</section>

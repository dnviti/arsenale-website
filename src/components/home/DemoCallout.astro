---
---

<section class="py-20">
  <div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="relative bg-dark-surface border border-primary/30 rounded-2xl p-8 sm:p-12 text-center overflow-hidden">
      <!-- Glow effect -->
      <div class="absolute inset-0 bg-gradient-to-br from-primary/5 via-transparent to-accent/5 pointer-events-none" aria-hidden="true"></div>

      <div class="relative">
        <h2 class="text-3xl font-bold text-white mb-4">Try Arsenale Now</h2>
        <p class="text-text-secondary mb-8 max-w-lg mx-auto">
          Explore the full interface with pre-configured connections. No installation required.
        </p>

        <!-- Credentials card -->
        <div class="bg-dark-bg/80 border border-dark-border rounded-xl p-6 mb-8 max-w-md mx-auto text-left font-mono text-sm">
          <div class="space-y-3">
            <div class="flex items-center justify-between">
              <span class="text-text-muted w-20">URL</span>
              <span class="text-accent flex-1 text-right">demo.arsenalepam.com</span>
            </div>
            <div class="flex items-center justify-between">
              <span class="text-text-muted w-20">Email</span>
              <span class="text-text-primary flex-1 text-right">demo@arsenalepam.com</span>
            </div>
            <div class="flex items-center justify-between">
              <span class="text-text-muted w-20">Password</span>
              <span class="text-text-primary flex-1 text-right">arsenaledemo</span>
            </div>
          </div>
        </div>

        <a
          href="https://demo.arsenalepam.com"
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center gap-2 px-8 py-3.5 text-base font-semibold text-white bg-primary hover:bg-primary-dark rounded-lg transition-colors shadow-lg shadow-primary/25"
        >
          <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6" />
            <polyline points="15 3 21 3 21 9" />
            <line x1="10" y1="14" x2="21" y2="3" />
          </svg>
          Open Demo
        </a>

        <p class="mt-6 text-xs text-text-muted">
          Demo environment resets periodically. Do not store real credentials.
        </p>
      </div>
    </div>
  </div>
</section>

---
---

<section class="py-24 sm:py-32">
  <div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="relative bg-dark-surface/80 border border-accent/15 rounded-2xl p-8 sm:p-12 text-center overflow-hidden" data-animate>
      <!-- Glow effect -->
      <div class="absolute inset-0 bg-gradient-to-br from-accent/[0.03] via-transparent to-accent/[0.02] pointer-events-none" aria-hidden="true"></div>

      <div class="relative">
        <h2 class="text-3xl sm:text-4xl font-serif text-text-primary mb-4">Try Arsenale Now</h2>
        <p class="text-text-secondary mb-10 max-w-lg mx-auto">
          Explore the full interface with pre-configured connections. No installation required.
        </p>

        <!-- Credentials card (terminal style) -->
        <div class="bg-dark-bg border border-dark-border/60 rounded-xl p-6 mb-10 max-w-md mx-auto text-left font-mono text-sm">
          <div class="flex items-center gap-2 mb-4 pb-3 border-b border-dark-border/40">
            <span class="w-2.5 h-2.5 rounded-full bg-accent/40"></span>
            <span class="w-2.5 h-2.5 rounded-full bg-text-muted/30"></span>
            <span class="w-2.5 h-2.5 rounded-full bg-text-muted/30"></span>
            <span class="text-[11px] text-text-muted ml-2">credentials</span>
          </div>
          <div class="space-y-2.5">
            <div class="flex items-center gap-3">
              <span class="text-accent">$</span>
              <span class="text-text-muted w-20">URL</span>
              <span class="text-accent flex-1 text-right">demo.arsenalepam.com</span>
            </div>
            <div class="flex items-center gap-3">
              <span class="text-accent">$</span>
              <span class="text-text-muted w-20">Email</span>
              <span class="text-text-primary flex-1 text-right">demo@arsenalepam.com</span>
            </div>
            <div class="flex items-center gap-3">
              <span class="text-accent">$</span>
              <span class="text-text-muted w-20">Password</span>
              <span class="text-text-primary flex-1 text-right">arsenaledemo</span>
            </div>
          </div>
        </div>

        <a
          href="https://demo.arsenalepam.com"
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center gap-2.5 px-8 py-3.5 text-[15px] font-semibold text-dark-bg bg-accent hover:bg-accent-dim rounded-lg transition-colors duration-300"
        >
          <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
            <path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6" />
            <polyline points="15 3 21 3 21 9" />
            <line x1="10" y1="14" x2="21" y2="3" />
          </svg>
          Open Demo
        </a>

        <p class="mt-6 text-xs text-text-muted">
          Demo environment resets periodically. Do not store real credentials.
        </p>
      </div>
    </div>
  </div>
</section>

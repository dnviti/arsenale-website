---
interface Props {
  title: string;
  subtitle?: string;
  id?: string;
}

const { title, subtitle, id } = Astro.props;
---

<div class="text-center mb-12" id={id}>
  <h2 class="text-3xl sm:text-4xl font-bold text-white mb-4">{title}</h2>
  {subtitle && <p class="text-lg text-text-secondary max-w-2xl mx-auto">{subtitle}</p>}
</div>

---
interface Props {
  title: string;
  subtitle?: string;
  id?: string;
  number?: string;
  align?: 'center' | 'left';
}

const { title, subtitle, id, number, align = 'center' } = Astro.props;
---

<div class:list={[
  'mb-14',
  align === 'center' ? 'text-center' : 'text-left',
]} id={id}>
  {number && (
    <span class="block font-serif text-accent/30 text-5xl sm:text-6xl mb-2 select-none" aria-hidden="true">
      {number}
    </span>
  )}
  <h2 class="text-3xl sm:text-4xl lg:text-5xl font-serif text-text-primary mb-4 leading-tight">
    {title}
  </h2>
  {subtitle && (
    <p class:list={[
      'text-base sm:text-lg text-text-secondary leading-relaxed',
      align === 'center' && 'max-w-2xl mx-auto',
    ]}>
      {subtitle}
    </p>
  )}
</div>
